DirectoryIndex index.php

RewriteEngine On

# 🔒 Forzar HTTPS (excepto en localhost / desarrollo).
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# 🔒 Bloquear las carpetas internas (la base SQLite y el contexto de la IA).
RewriteRule ^(datos|contexto)(/|$) - [F,L]

# 🔒 Bloquear archivos sensibles por extensión, en cualquier ubicación.
<FilesMatch "\.(sqlite|sqlite3|db|sql|log|ini)$">
    Require all denied
</FilesMatch>
